# Meshling bridge settings. Copy to ~/.meshling.env, fill in, and never commit the copy.
# Load with:  set -a; . ~/.meshling.env; set +a

# Serial port of the MeshCore Companion USB radio (macOS: ls /dev/cu.usb*)
MESHLING_PORT=/dev/cu.usbmodemXXXX

# Your Sprite's message endpoint
MESHLING_URL=https://YOUR-SPRITE.sprites.app/message

# Sprites org token, sent as a Bearer token while the Sprite URL is private
SPRITES_TOKEN=replace-with-your-sprites-token

# Shared key the server checks (the contents of /app/data/secret, or a key whose
# SHA-256 hash is listed in /app/data/key_hashes). Make one with: openssl rand -hex 24
MESHLING_KEY=replace-with-your-shared-key

# Optional
MESHLING_CHANNEL=#meshling
# MESHLING_CHANNEL_SECRET=   # 32 hex chars, only for a private channel not starting with "#"
MESHLING_ALLOW_DMS=0
MESHLING_MAX_CHARS=120
MESHLING_MAX_PARTS=3
MESHLING_PART_GAP=5
MESHLING_SEND_GAP=15
MESHLING_HTTP_TIMEOUT=30
MESHLING_REPLY_DELAY=6
